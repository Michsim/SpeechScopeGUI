{
  "name": "acoustic.quality.cpp",
  "version": "1.0",
  "tasks": [
    "ddk",
    "monologue",
    "phonation",
    "reading",
    "story"
  ],
  "requires": [],
  "vad": {
    "supported": true,
    "required": false,
    "default": {
      "ddk": false,
      "monologue": false,
      "phonation": false,
      "reading": false,
      "story": false
    }
  },
  "outputs": {
    "cpp": "Cepstral peak prominence (dB)",
    "cpps": "Cepstral peak prominence smoothed (dB)"
  },
  "params": {
    "window_length": {
      "default": 0.041,
      "type": "float",
      "description": "Délka okna (s)",
