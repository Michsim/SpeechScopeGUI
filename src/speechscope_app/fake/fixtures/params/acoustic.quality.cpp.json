    "window_overlap": {
      "default": 90.0,
      "type": "float",
      "description": "Překryv oken (%)",
      "ge": 0,
      "lt": 100
    },
    "time_smoothing": {
      "default": 10,
      "type": "int",
      "description": "Řád filtru pro časové průměrování cepster (jen CPPS)",
      "ge": 1
    },
    "quefrency_smoothing": {
      "default": 5,
      "type": "int",
      "description": "Řád filtru pro vyhlazení v kvefrenci (jen CPPS)",
      "ge": 1
    }
  }
}
