{
  "kind": "provider",
  "name": "phonemes",
  "version": "1.1",
  "requires": [],
  "params": {
    "phnrec_dir": {
      "default": "",
      "type": "str",
      "description": "Složka s phnrec.exe a modelem; prázdné = úložiště modelů"
