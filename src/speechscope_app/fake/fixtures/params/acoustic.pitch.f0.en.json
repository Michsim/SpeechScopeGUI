{
  "kind": "feature",
  "name": "acoustic.pitch.f0",
  "version": "1.1",
  "tasks": [
    "ddk",
    "monologue",
    "phonation",
    "reading",
    "story"
  ],
  "requires": [],
  "vad": {
    "supported": true,
    "required": false,
    "default": {
      "ddk": false,
      "monologue": false,
      "phonation": false,
      "reading": false,
      "story": false
    }
  },
  "description": "",
  "outputs": {
    "std": "Standard deviation of the F0 contour (semitones)",
    "median": "Median of the F0 contour (semitones)",
    "mean": "Mean of the F0 contour (semitones)",
    "max": "Maximum of the F0 contour (semitones)",
    "min": "Minimum of the F0 contour (semitones)",
    "median_hz": "Median of the F0 contour (Hz)",
    "mean_hz": "Mean of the F0 contour (Hz)",
    "range": "F0 range, 95th minus 5th percentile (semitones)",
    "voiced_fraction": "Fraction of voiced frames among all contour frames (0 to 1)"
  },
  "params": {
    "f_min": {
      "default": 60.0,
      "type": "float",
      "description": "Lowest allowed F0 (Hz)",
      "gt": 0
    },
    "f_max": {
      "default": 400.0,
      "type": "float",
      "description": "Highest allowed F0 (Hz)",
      "gt": 0
    },
    "timestep": {
      "default": 0.01,
      "type": "float",
      "description": "Analysis window step (s)",
      "gt": 0
    },
    "strength_threshold": {
      "default": 0.3,
      "type": "float",
      "description": "Minimum pitch strength below which a frame is unvoiced",
      "ge": 0,
      "le": 1
    },
    "semitone_ref_mode": {
      "default": "fmin",
      "type": "str",
      "description": "Semitone reference: fmin (as in the legacy script), fixed (fixed Hz), median (speaker median)",
      "choices": [
        "fmin",
        "fixed",
        "median"
      ]
    },
    "semitone_ref_hz": {
      "default": 100.0,
      "type": "float",
      "description": "Reference frequency for the fixed mode (Hz)",
      "gt": 0
    },
    "drop_bounds": {
      "default": true,
      "type": "bool",
      "description": "Drop frames where SWIPE hit f_min or f_max (artefact on silence and noise); False = as in the legacy script"
    },
    "outlier_semitones": {
      "default": 12.0,
      "type": "float",
      "description": "Frames farther than this many semitones from the contour median are dropped; 0 = no cleaning",
      "ge": 0
    }
  }
}
